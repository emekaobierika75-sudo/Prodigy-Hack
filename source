// CrackinPMG Cheat Menu - Full Version
// GUI + All hack logic from ProdigyPNP TypeScript sources, converted to plain JS

var script = document.createElement("script");
script.src = "https://cdn.jsdelivr.net/npm/sweetalert2@11";
document.head.appendChild(script);

script.onload = function () {

  // ─── STYLES ───────────────────────────────────────────────────────────────
  var style = document.createElement("style");
  style.innerHTML = `
    @import url('https://fonts.googleapis.com/css2?family=Rajdhani:wght@500;600;700&family=Inter:wght@400;500&display=swap');

    :root {
      --bg: #0d0d0d;
      --surface: #141414;
      --surface2: #1c1c1c;
      --border: #2a2a2a;
      --accent: #f97316;
      --text: #f0f0f0;
      --muted: #777;
      --toggle-on: #f97316;
      --toggle-off: #333;
      --radius: 6px;
    }

    #crackin-menu {
      position: fixed;
      top: 0; left: 0;
      width: 100%; height: 100%;
      background: var(--bg);
      color: var(--text);
      z-index: 99999;
      font-family: 'Inter', sans-serif;
      font-size: 13px;
      display: flex;
      flex-direction: column;
      transform: translateY(-100%);
      transition: transform 0.28s cubic-bezier(.4,0,.2,1);
      overflow: hidden;
    }
    #crackin-menu.open { transform: translateY(0); }

    #crackin-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 12px 20px;
      background: var(--surface);
      border-bottom: 1px solid var(--border);
      flex-shrink: 0;
    }
    #crackin-header .logo {
      font-family: 'Rajdhani', sans-serif;
      font-weight: 700;
      font-size: 20px;
      letter-spacing: 1px;
      color: var(--accent);
    }
    #crackin-header .logo span { color: var(--text); }
    #crackin-header .subtitle { font-size: 11px; color: var(--muted); margin-top: 1px; }

    #crackin-tabs {
      display: flex;
      gap: 2px;
      padding: 10px 20px 0;
      background: var(--surface);
      border-bottom: 1px solid var(--border);
      flex-shrink: 0;
      overflow-x: auto;
      scrollbar-width: none;
    }
    #crackin-tabs::-webkit-scrollbar { display: none; }

    .crackin-tab {
      padding: 7px 14px;
      border-radius: var(--radius) var(--radius) 0 0;
      cursor: pointer;
      font-family: 'Rajdhani', sans-serif;
      font-weight: 600;
      font-size: 13px;
      letter-spacing: 0.5px;
      color: var(--muted);
      border: 1px solid transparent;
      border-bottom: none;
      white-space: nowrap;
      transition: color 0.15s, background 0.15s;
      position: relative;
      bottom: -1px;
    }
    .crackin-tab:hover { color: var(--text); }
    .crackin-tab.active {
      color: var(--accent);
      background: var(--bg);
      border-color: var(--border);
      border-bottom-color: var(--bg);
    }
    .crackin-tab.tab-beta { color: #a855f7; }
    .crackin-tab.tab-beta.active { color: #c084fc; }
    .crackin-tab.tab-patched { color: #6b7280; }
    .crackin-tab.tab-patched.active { color: #9ca3af; }

    #crackin-content {
      flex: 1;
      overflow-y: auto;
      padding: 20px;
      scrollbar-width: thin;
      scrollbar-color: var(--border) transparent;
    }
    .crackin-panel { display: none; }
    .crackin-panel.active { display: block; }

    .crackin-panel-title {
      font-family: 'Rajdhani', sans-serif;
      font-weight: 700;
      font-size: 18px;
      color: var(--accent);
      letter-spacing: 1px;
      margin-bottom: 14px;
      padding-bottom: 8px;
      border-bottom: 1px solid var(--border);
      display: flex;
      align-items: center;
      gap: 8px;
    }
    .pill {
      font-size: 10px;
      font-family: 'Inter', sans-serif;
      font-weight: 500;
      padding: 2px 7px;
      border-radius: 99px;
      letter-spacing: 0.5px;
    }
    .pill-beta { background: #581c87; color: #c084fc; }
    .pill-patched { background: #1f2937; color: #9ca3af; }

    .crackin-grid {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
    }

    .crackin-btn {
      padding: 8px 14px;
      background: var(--surface2);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      color: var(--text);
      cursor: pointer;
      font-family: 'Inter', sans-serif;
      font-size: 12px;
      font-weight: 500;
      transition: background 0.15s, border-color 0.15s, color 0.15s;
      white-space: nowrap;
    }
    .crackin-btn:hover { background: var(--accent); border-color: var(--accent); color: #000; }
    .crackin-btn.btn-beta { border-color: #581c87; color: #c084fc; }
    .crackin-btn.btn-beta:hover { background: #7e22ce; border-color: #7e22ce; color: #fff; }
    .crackin-btn.btn-patched { border-color: #374151; color: #6b7280; text-decoration: line-through; opacity: 0.7; }
    .crackin-btn.btn-patched:hover { background: #374151; border-color: #374151; color: #9ca3af; text-decoration: none; opacity: 1; }

    .crackin-toggle-row {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 9px 14px;
      background: var(--surface2);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      cursor: pointer;
      transition: border-color 0.15s;
      min-width: 200px;
    }
    .crackin-toggle-row:hover { border-color: var(--accent); }
    .crackin-toggle-row .label { flex: 1; font-size: 12px; font-weight: 500; }

    .crackin-switch { position: relative; width: 36px; height: 20px; flex-shrink: 0; }
    .crackin-switch input { display: none; }
    .crackin-switch .track {
      position: absolute; inset: 0;
      border-radius: 99px;
      background: var(--toggle-off);
      transition: background 0.2s;
    }
    .crackin-switch .thumb {
      position: absolute;
      top: 3px; left: 3px;
      width: 14px; height: 14px;
      border-radius: 50%;
      background: #fff;
      transition: transform 0.2s;
    }
    .crackin-switch input:checked + .track { background: var(--toggle-on); }
    .crackin-switch input:checked ~ .thumb { transform: translateX(16px); }

    #crackin-footer {
      padding: 8px 20px;
      background: var(--surface);
      border-top: 1px solid var(--border);
      color: var(--muted);
      font-size: 11px;
      display: flex;
      justify-content: space-between;
      flex-shrink: 0;
    }

    #crackin-toggler {
      position: fixed;
      top: 0; left: 0;
      z-index: 100000;
      width: 34px; height: 34px;
      background: var(--surface);
      border: 1px solid var(--border);
      border-top: none; border-left: none;
      border-radius: 0 0 var(--radius) 0;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--accent);
      font-size: 16px;
      transition: background 0.15s;
    }
    #crackin-toggler:hover { background: var(--surface2); }

    .my-swal { z-index: 200000 !important; }
    .my-popup { width: 400px !important; }
  `;
  document.head.appendChild(style);

  // ─── SWAL HELPERS (mirrors the TS utils/swal) ─────────────────────────────
  var SC = { container: "my-swal", popup: "my-popup" };

  var Toast = Swal.mixin({
    toast: true,
    position: "top-end",
    showConfirmButton: false,
    timer: 3000,
    timerProgressBar: true,
    customClass: SC
  });

  var NumberInput = {
    fire: function(title, text, icon) {
      return Swal.fire({
        title: title || "Enter a number",
        text: text,
        icon: icon || "question",
        input: "number",
        showCancelButton: true,
        customClass: SC
      });
    }
  };

  var Input = {
    fire: function(titleOrOpts, text, icon) {
      if (typeof titleOrOpts === "object") {
        return Swal.fire(Object.assign({ showCancelButton: true, customClass: SC, input: titleOrOpts.input || "text" }, titleOrOpts));
      }
      return Swal.fire({
        title: titleOrOpts || "Enter a value",
        text: text,
        icon: icon,
        input: "text",
        showCancelButton: true,
        customClass: SC
      });
    }
  };

  var Confirm = {
    fire: function(titleOrOpts, text, icon) {
      if (typeof titleOrOpts === "object") {
        return Swal.fire(Object.assign({ showCancelButton: true, confirmButtonText: "Yes", cancelButtonText: "No", customClass: SC }, titleOrOpts));
      }
      return Swal.fire({
        title: titleOrOpts || "Are you sure?",
        text: text,
        icon: icon || "warning",
        showCancelButton: true,
        confirmButtonText: "Yes",
        cancelButtonText: "No",
        customClass: SC
      });
    }
  };

  // ─── PRODIGY HELPERS (mirrors utils/util + utils/hackify) ─────────────────

  // Build the _ object (inject container walker) - same pattern as the original code
  var _ = window._ || {};
  var VERY_LARGE_NUMBER = 9007199254740991;

  function getPlayer() {
    try { return Boot.prototype.game._state._current.user.source; } catch(e) { return null; }
  }
  function getProdigy() {
    try { return Boot.prototype.add.prodigyGame; } catch(e) { return null; }
  }
  function getGame() {
    try { return Boot.prototype.game; } catch(e) { return null; }
  }
  function getCurrent() {
    try { return Boot.prototype.game._state._current; } catch(e) { return null; }
  }

  function saveCharacter() {
    try {
      var p = getPlayer();
      p._saveEnabled = true;
      p.updated = true;
      p.appearanceChanged = true;
      p.saveEnabled = true;
      p.forceSaveCharacter();
    } catch(e) { console.error("saveCharacter error:", e); }
  }

  // itemify: takes an array of game data items and returns backpack-format array
  function itemify(arr, amount) {
    return arr.map(function(x) { return { ID: x.ID, N: amount }; });
  }

  // ids / names used by inventory hacks
  var ids   = ["boots","follow","fossil","hat","item","key","mount","outfit","relic","spellRelic","weapon","currency"];
  var names = ["Boots","Buddies","Fossils","Hats","Items","Key Items","Mounts","Outfits","Relics","Spell Relics","Weapons","Currency"];

  // runeify
  function runeify(orbData, amount) {
    return orbData.map(function(x) { return { ID: x.ID, N: amount }; });
  }

  // getMemberModule
  function getMemberModule() {
    var mod;
    try {
      Array.from(Boot.prototype.add.prodigyGame._rootContainer._inversifyContainer._bindingDictionary._map).forEach(function(e) {
        try {
          var obj = Boot.prototype.add.prodigyGame._rootContainer._inversifyContainer.get(e[0]);
          if (obj && obj.data && obj.data.membership) mod = e[0];
        } catch(err) {}
      });
    } catch(e) {}
    return mod;
  }

  // getPet: shows a swal to pick from kennel, returns index
  async function getPet(title) {
    try {
      var p = getPlayer();
      var kennel = p.kennel.data;
      var gameData = Boot.prototype.game._state._states.get("Boot")._gameData.pet;
      var opts = {};
      kennel.forEach(function(pet, i) {
        var name = (gameData.find(function(x) { return x.ID == pet.ID; }) || {}).data;
        opts[i] = (name ? name.name : "Unknown") + " (Lv " + pet.level + ")";
      });
      var res = await Swal.fire({ title: title || "Select a pet", input: "select", inputOptions: opts, showCancelButton: true, customClass: SC });
      if (res.value === undefined) return undefined;
      return parseInt(res.value);
    } catch(e) { return undefined; }
  }

  // toHouse
  function toHouse(userID) {
    try { Boot.prototype.game._state._current._world.zones.house.teleport("preview-" + userID); } catch(e) { console.error(e); }
  }

  // getItem helper
  function getItem(type, id) {
    try { return Boot.prototype.game._state._states.get("Boot")._gameData[type].find(function(x) { return x.ID === id; }); } catch(e) { return null; }
  }

  // ─── FPS COUNTER ──────────────────────────────────────────────────────────
  var fpsEl = null, fpsFrame = null, fpsLast = performance.now(), fpsCount = 0;
  function startFps() {
    if (fpsEl) return;
    fpsEl = document.createElement("div");
    fpsEl.style.cssText = "position:fixed;bottom:8px;right:8px;background:#000a;color:#f97316;font-family:monospace;font-size:13px;padding:4px 8px;border-radius:4px;z-index:999999;pointer-events:none;";
    document.body.appendChild(fpsEl);
    function loop() {
      fpsFrame = requestAnimationFrame(loop);
      fpsCount++;
      var now = performance.now();
      if (now - fpsLast >= 1000) {
        fpsEl.textContent = fpsCount + " FPS";
        fpsCount = 0;
        fpsLast = now;
      }
    }
    loop();
  }
  function stopFps() {
    if (fpsFrame) cancelAnimationFrame(fpsFrame);
    if (fpsEl) { fpsEl.remove(); fpsEl = null; }
  }

  // PopupInterval
  var popupIntervalID = null;
  function PopupInterval(on) {
    if (on) {
      popupIntervalID = setInterval(function() {
        try { Boot.prototype.add.prodigyGame.open.menuCloseAll(); } catch(e) {}
      }, 500);
    } else {
      if (popupIntervalID) clearInterval(popupIntervalID);
    }
  }

  // ─── HACK DEFINITIONS ─────────────────────────────────────────────────────
  // Each entry: { id, label, tabClass, pill, items: [{ type, label, cls, fn, enabledFn, disabledFn }] }

  var categories = [

    // ── PLAYER ──────────────────────────────────────────────────────────────
    { id: "player", label: "Player Hacks", items: [

      { type: "hack", label: "Open ProdigyPNP Chat", fn: async function() {
        Swal.fire({ title: "ProdigyPNP Chat", html: "Chat integration not available in standalone build.", icon: "info", customClass: SC });
      }},

      { type: "hack", label: "Max Account", fn: async function() {
        if (!(await Confirm.fire("Are you sure that you want to max your account?", "We recommend doing this on an alt.")).value) return;
        var p = getPlayer();
        p.data.gold = 9900000;
        var xpConstant = 1.042;
        var h = 100 - 2;
        p.data.stars = Math.round((1 - Math.pow(xpConstant, h)) / (1 - xpConstant) * 20 + 10);
        p.data.level = 100;
        p.getLevel = function() { return 100; };
        p.data.bountyScore = 100;
        for (var i = 0; i < 99; i++) {
          try { getProdigy().giftBoxController.receiveGiftBox(null, getItem("giftBox", 1)); } catch(e) {}
        }
        for (var i = 0; i < 100; i++) { try { p.achievements.data.progress[i] = 10; } catch(e) {} }
        p.data.tower = 100;
        var num = 1;
        var gd = Boot.prototype.game._state._states.get("Boot")._gameData;
        ids.forEach(function(id) {
          p.backpack.data[id] = itemify(gd[id].filter(function(l) { return id === "follow" ? ![125,126,127,128,129,134,135,136,137].includes(l.ID) : l; }), num);
        });
        gd.dorm.forEach(function(x) { p.house.data.items[x.ID] = { A: [], N: num }; });
        var bountyIndex = function() { return p.backpack.data.item.findIndex(function(v) { return v.ID===84||v.ID===85||v.ID===86; }); };
        while (bountyIndex() > -1) p.backpack.data.item.splice(bountyIndex(), 1);
        p.backpack.data.mount = itemify(gd.mount, 1);
        var amt = 6969420;
        p.backpack.data.currency = itemify(gd.currency, amt);
        gd.pet.forEach(function(x) { try { p.kennel.addPet(x.ID.toString(), VERY_LARGE_NUMBER, 26376, 100); } catch(e) {} });
        p.kennel._encounterInfo._data.pets = [];
        gd.pet.forEach(function(pet) { p.kennel._encounterInfo._data.pets.push({ firstSeenDate: Date.now(), ID: pet.ID, timesBattled: 1, timesRescued: 1 }); });
        p.kennel.petTeam.forEach(function(v) { if (v && v.assignRandomSpells) v.assignRandomSpells(); });
        p.equipment.setHat(200); p.equipment.setBoots(93); p.equipment.setOutfit(161); p.equipment.setWeapon(196);
        p.appearanceChanged = true;
        saveCharacter();
        return Toast.fire("Maxed!", "Check your backpack!", "success");
      }},

      { type: "hack", label: "Set Gold", fn: async function() {
        var res = await NumberInput.fire("Gold Amount", "What number do you want to set your gold to? (Max 10,000,000)", "question");
        if (res.value === undefined) return;
        if (+res.value > 10000000) return Toast.fire("Error", "Cannot have more than 10,000,000 gold.", "error");
        getPlayer().data.gold = +res.value;
        return Toast.fire("Success!", "You now have " + res.value + " gold.", "success");
      }},

      { type: "hack", label: "Set Level", fn: async function() {
        var res = await NumberInput.fire("Level", "What level do you want?", "question");
        if (res.value === undefined) return;
        var i = res.value - 2, xpC = 1.042;
        getPlayer().data.stars = Math.round((1 - Math.pow(xpC, i)) / (1 - xpC) * 20 + 10);
        getPlayer().data.level = +res.value;
        getPlayer().getLevel = function() { return getPlayer().data.level; };
        return Toast.fire("Success!", "You are now level " + res.value + ".", "success");
      }},

      { type: "hack", label: "Get Member Stars", fn: async function() {
        var res = await NumberInput.fire("Stars", "How many member stars do you want?", "question");
        if (res.value === undefined) return;
        getPlayer().data.storedMemberStars = +res.value;
        return Toast.fire("Success!", "Member stars set to " + res.value + ".", "success");
      }},

      { type: "hack", label: "Set Bounty Points", fn: async function() {
        var res = await NumberInput.fire("Bounty Points", "Max is 100.", "question");
        if (res.value === undefined) return;
        getPlayer().data.bountyScore = Math.min(+res.value, 100);
        return Toast.fire("Success!", "Bounty points set.", "success");
      }},

      { type: "hack", label: "Obtain Conjure Cubes", fn: async function() {
        var res = await NumberInput.fire("Conjure Cubes", "How many? (Max 99)", "question");
        if (res.value === undefined) return;
        for (var i = 0; i < Math.min(99, +res.value); i++) {
          try { getProdigy().giftBoxController.receiveGiftBox(null, getItem("giftBox", 1)); } catch(e) {}
        }
        return Toast.fire("Success!", "You gained " + res.value + " conjure cubes.", "success");
      }},

      { type: "hack", label: "Set Wins", fn: async function() {
        var res = await NumberInput.fire("Wins", "What number?", "question");
        if (res.value === undefined) return;
        getPlayer().data.win = +res.value;
        return Toast.fire("Success!", "Wins set to " + res.value + ".", "success");
      }},

      { type: "hack", label: "Set Losses", fn: async function() {
        var res = await NumberInput.fire("Losses", "What number?", "question");
        if (res.value === undefined) return;
        getPlayer().data.loss = +res.value;
        return Toast.fire("Success!", "Losses set to " + res.value + ".", "success");
      }},

      { type: "toggle", label: "Toggle Membership",
        enabledFn: async function() {
          try { Boot.prototype.add.prodigyGame._rootContainer._inversifyContainer.get(getMemberModule()).data.membership.active = true; } catch(e) {}
          getPlayer().appearanceChanged = true;
          return Toast.fire("Success!", "Membership enabled!", "success");
        },
        disabledFn: async function() {
          try { Boot.prototype.add.prodigyGame._rootContainer._inversifyContainer.get(getMemberModule()).data.membership.active = false; } catch(e) {}
          getPlayer().appearanceChanged = true;
          return Toast.fire("Success!", "Membership disabled.", "success");
        }
      },

      { type: "hack", label: "Set Name (Client Side)", fn: async function() {
        var res = await Input.fire("What would you like to set your name to?");
        if (!res.value) return;
        getPlayer().getName = function() { return res.value; };
        getPlayer().appearanceChanged = true;
        return Toast.fire("Changed!", "Your name was changed.");
      }},

      { type: "hack", label: "Change Name", fn: async function() {
        var names = Boot.prototype.game._state._states.get("Boot")._gameData.name;
        var div = document.createElement("div");
        var createSelect = function(arr, eqFn) {
          var select = document.createElement("select");
          select.classList.add("selectName");
          arr.forEach(function(opt) {
            var el = document.createElement("option");
            el.value = opt[0]; el.innerText = opt[1];
            if (eqFn(opt[0])) el.selected = true;
            select.options.add(el);
          });
          return select;
        };
        var p = getPlayer();
        div.append(createSelect(names.filter(function(x){return x.data.type===0;}).map(function(x){return[x.ID.toString(),x.name];}), function(v){return +v===p.name.data.firstName;}));
        div.append(createSelect(names.filter(function(x){return x.data.type===1;}).map(function(x){return[x.ID.toString(),x.name];}), function(v){return +v===p.name.data.middleName;}));
        div.append(createSelect(names.filter(function(x){return x.data.type===2;}).map(function(x){return[x.ID.toString(),x.name];}), function(v){return +v===p.name.data.lastName;}));
        var nicks = Boot.prototype.game._state._states.get("Boot")._gameData.nickname;
        div.append(createSelect([["null","[none]"]].concat(nicks.map(function(x){return[x.ID.toString(),x.name];})), function(v){return +v===p.name.data.nickname||String(p.name.data.nickname)===v;}));
        var res = await Swal.fire({ title:"Set Player Name", focusConfirm:false, showCancelButton:true, html:div, customClass:SC, preConfirm:function(){return Array.prototype.slice.call(document.querySelectorAll(".selectName")).map(function(x){return x.options[x.selectedIndex].value;});}});
        if (res.value === undefined) return;
        if (res.value[3] === "null") res.value[3] = null;
        p.name.data.firstName = res.value[0] && +res.value[0];
        p.name.data.middleName = res.value[1] && +res.value[1];
        p.name.data.lastName = res.value[2] && +res.value[2];
        p.name.data.nickname = res.value[3] && +res.value[3];
        p.appearanceChanged = true;
        return Toast.fire("Name Changed!", "Your name was successfully changed.", "success");
      }},

      { type: "hack", label: "Uncap Player Level (Client Side)", fn: async function() {
        var res = await NumberInput.fire("Level", "What level? (Can be >100)", "question");
        if (!res.value) return;
        eval("getPlayer().getLevel = () => " + res.value);
        return Toast.fire("Updated!", "Level updated (client side).", "success");
      }},

      { type: "hack", label: "Get All Achievements", fn: async function() {
        var p = getPlayer();
        for (var i = 0; i < 100; i++) { try { p.achievements.data.progress[i] = 10; } catch(e) {} }
        return Toast.fire("Success!", "All achievements obtained!", "success");
      }},

      { type: "hack", label: "Fix Morph Crash", fn: async function() {
        getPlayer().getPlayerData().playerTransformation = undefined;
        getPlayer().appearanceChanged = true;
        return Toast.fire("Success!", "Fixed morph crash bug.", "success");
      }},

      { type: "hack", label: "Permanent Morph", fn: async function() {
        var p = getPlayer();
        if (!p.data.playerTransformation) return Swal.fire("No Morph Active", "Please use a Morph Marble and try again.", "error");
        p.data.playerTransformation.maxTime = Infinity;
